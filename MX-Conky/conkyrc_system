################################
#.conkyrc_system
################################
# My adapted/changed MX Conky
# 31JAN26
#####################
#  Settings
#####################
background yes
use_xft yes
xftfont Sans:size=08
xftalpha 1
update_interval 1.0
total_run_times 0
own_window yes
own_window_transparent no
own_window_type normal
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
double_buffer yes
minimum_size 250 1500
maximum_width 300
draw_shades yes
draw_outline no
draw_borders no
draw_graph_borders no
default_color white
default_shade_color black
default_outline_color white
# greenish
   color1 42fc0a
# lightblueish
   color2 4286f4
# blueish
   color3 0254d8
# orangeish
   color4 ea6c04
# blue
   color5 0000FF
# Mulberry
   color6 C64191
# Atomic Tangerine
   color7 F79F79
# SGBUS Green
   color8 84DD63
# Amaranth Purple
   color9 AF1B3F
alignment top_right
font = 'Roboto Mono:size=08',
font1 = 'Hack:size=10',
font2 = 'Voice of Truth:size=16',
font3 = 'HUN-din 1451:size=08',
font4 = 'Stoopid Markers:size=16',
font5 = 'BlowBrush:size=24',
font6 = 'Urban Jungle:size=20',
gap_x -1800
gap_y 150
uppercase no
cpu_avg_samples 2
override_utf8_locale no
#####################
#  Output
#####################
own_window_argb_value 0
own_window_argb_visual yes
own_window_colour 000000

TEXT

