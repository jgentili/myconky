conky.text = [[
${voffset 10}${font Stoopid Markers:size=50}${color4}${time %A}${color}${font}${voffset -10}
${voffset 10}${font Urban Jungle:size=42}${time %B} ${time %e}${font}${voffset -10}
${voffset -10}${font Voice of Truth:size=60}${color3}${time %I:%M %p}${color}${font}${voffset -10}

]]
