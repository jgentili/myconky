# Conky Time Date Clock
conky.config = {
    alignment = 'bottom_left',
    background = true,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = 'gray',
    default_outline_color = 'white',
    default_shade_color = 'white',
# Dark Moss Green
    color1 = '#115D00',
# Mulberry
    color2 = '#C64191',
# Atomic Tangerine
    color3 = '#F79F79',
# SGBUS Green
    color4 = '#84DD63',
# Amaranth Purple
    color5 = '#AF1B3F',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Roboto Mono:size=8',
    font1 = 'Hack:size=12',
font2 = 'Voice of Truth:size=24',
font3 = 'HUN-din 1451:size=16',
font4 = 'Stoopid Markers:size=18',
font5 = 'BlowBrush:size=18',
